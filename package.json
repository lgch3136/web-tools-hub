    "mammoth": "^1.12.0",
    "marked": "^15.0.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "buffer": "^6.0.3",
    "parcel": "^2.12.0",
    "process": "^0.11.10"
  }
}
